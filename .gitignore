# Rust build output
/target
**/*.rs.bk
*.pdb

# Generated test fixtures, rebuilt by `cargo xtask fixtures`
/fixtures/

# Benchmark output
/bench-results/

# Local scratch
/.scratch/

# What commitscape writes when run from this folder: cards, reports, Wrapped
/*-card.svg
/*-report.html
/wrapped-*.html

# The browser interface: dependencies, and the build cargo embeds
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/

# Nix: `nix build` links its output here; direnv keeps its cache here
/result
/result-*
/.direnv/

# Secrets
.env
.env.*

# Editors and operating systems
/.idea/
/.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Logs
*.log
