{
  "name": "@commitscape/site",
  "private": true,
  "version": "0.0.0",
  "description": "The hosted Site: TanStack Start on Node (Nitro), Postgres and R2.",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import ./instrument.server.mjs node_modules/vite/bin/vite.js dev --port 3100",
    "build": "vite build && cp instrument.server.mjs .output/server/",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c .oxlintrc.json src e2e scripts",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@astryxdesign/core": "catalog:",
    "@astryxdesign/theme-neutral": "catalog:",
    "@commitscape/data": "workspace:*",
    "@commitscape/server": "workspace:*",
    "@commitscape/ui": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@posthog/react": "1.11.2",
    "@resvg/resvg-js": "2.6.2",
    "@sentry/tanstackstart-react": "11.0.0",
    "@stylexjs/stylex": "catalog:",
    "@t3-oss/env-core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.58",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "lucide-react": "1.48.0",
    "pdfkit": "0.20.2",
    "posthog-js": "1.434.15",
    "react": "catalog:",
    "react-dom": "catalog:",
    "satori": "0.35.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query-devtools": "5.104.0",
    "@tanstack/react-router-devtools": "1.167.2",
    "@types/node": "catalog:",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "nitro": "3.0.260903-beta",
    "oxlint": "catalog:",
    "pg": "catalog:",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
