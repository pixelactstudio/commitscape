# Copy to .env for `pnpm dev` (compose.dev.yaml runs Postgres and s3mock).
DATABASE_URL=postgres://commitscape:commitscape@localhost:5434/commitscape

# R2 in production; s3mock from compose.dev.yaml here.
S3_ENDPOINT=http://localhost:9100
S3_BUCKET=commitscape-reports
S3_ACCESS_KEY_ID=commitscape
S3_SECRET_ACCESS_KEY=commitscape
S3_FORCE_PATH_STYLE=true

# `openssl rand -hex 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100

# Optional: a token for GitHub's API limits, and the GitHub App for signing in.
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional: errors and analytics.
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
PUBLIC_POSTHOG_KEY=
