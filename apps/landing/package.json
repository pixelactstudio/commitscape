{
  "name": "@commitscape/landing",
  "private": true,
  "version": "0.0.0",
  "description": "The landing page: static HTML for Cloudflare Workers, drawn at build time from the Site's components, with a little JavaScript for its scenes.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3200",
    "build": "vite build && node scripts/prerender.ts",
    "preview": "vite preview --port 3200",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "lint": "oxlint -c ../../.oxlintrc.json src scripts test worker",
    "test": "vitest run"
  },
  "dependencies": {
    "@astryxdesign/core": "catalog:",
    "@astryxdesign/theme-neutral": "catalog:",
    "@commitscape/data": "workspace:*",
    "@commitscape/ui": "workspace:*",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@stylexjs/stylex": "catalog:",
    "gsap": "3.15.1",
    "lucide-react": "1.69.0",
    "posthog-js": "1.446.3",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "tailwindcss": "4.3.4",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.158.0"
  }
}
