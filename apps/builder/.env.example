# Copy to .env for a local Builder (compose.dev.yaml runs Postgres and s3mock).
DATABASE_URL=postgres://commitscape:commitscape@localhost:5434/commitscape
S3_ENDPOINT=http://localhost:9100
S3_BUCKET=commitscape-reports
S3_ACCESS_KEY_ID=commitscape
S3_SECRET_ACCESS_KEY=commitscape
S3_FORCE_PATH_STYLE=true
MIGRATIONS_DIR=../../packages/server/drizzle
COMMITSCAPE_BIN=../../target/release/commitscape
WORK_DIR=../../target/builder-work

# Optional: GitHub's search limits and issue answers, and private repositories.
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
