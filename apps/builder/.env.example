# Copy to .env for a local Builder (compose.dev.yaml runs Postgres and s3mock).
DATABASE_URL=postgres://commitscape:commitscape@localhost:5434/commitscape
S3_ENDPOINT=http://localhost:9100
S3_BUCKET=commitscape-reports
S3_ACCESS_KEY_ID=commitscape
S3_SECRET_ACCESS_KEY=commitscape
S3_FORCE_PATH_STYLE=true
MIGRATIONS_DIR=../../packages/server/drizzle
COMMITSCAPE_BIN=../../target/release/commitscape
WORK_DIR=../../target/builder-work

# Optional: GitHub's search limits and issue answers, and private repositories.
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
TOKEN_SECRET=

# Optional: git data for the Code, Branches and Pull requests screens (defaults shown).
# GIT_DATA=true
# GIT_TIME_LIMIT_SECONDS=300
# GIT_BRANCHES_MAX=300
# GIT_TAGS_MAX=200
# GIT_BRANCH_DETAILS=120
# GIT_FILE_MAX_KB=256
# GIT_REPO_MAX_MB=48
# GIT_WARM_FILES=500
# GIT_PULLS_OPEN_MAX=150
# GIT_PULLS_OTHER_MAX=100
# GIT_PULL_DIFF_KB=200
# GIT_PULLS_MAX_MB=40
