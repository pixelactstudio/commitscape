# Copy to .env for `pnpm dev:engine`, which runs from the repository's root
# (compose.dev.yaml runs s3mock, where the local Builder uploads packs).
PORT=4100
ENGINE_TOKEN=dev-engine-token
S3_ENDPOINT=http://localhost:9100
S3_BUCKET=commitscape-reports
S3_ACCESS_KEY_ID=commitscape
S3_SECRET_ACCESS_KEY=commitscape
S3_FORCE_PATH_STYLE=true
PACK_DIR=target/engine-packs

# Optional (defaults shown): packs kept on disk and decoded in memory, and
# threads answering at once (every core, up to 16).
# PACK_DISK_GB=10
# PACK_MEMORY_MB=512
# COMMITSCAPE_THREADS=
# RUST_LOG=info

# Optional: Sentry (errors, and a span per request continued from the Site's trace).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=1
