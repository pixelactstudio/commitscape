{
  "name": "@commitscape/server",
  "private": true,
  "version": "0.0.0",
  "description": "What the Site and the Builder share on the server: the database, its migrations, R2, the Build queue and stored Reports.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/db/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:custom": "drizzle-kit generate --custom",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@commitscape/data": "workspace:*",
    "drizzle-orm": "catalog:",
    "lru-cache": "catalog:",
    "pg": "catalog:",
    "pg-boss": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
