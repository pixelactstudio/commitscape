{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".output/**"
      ],
      "env": [
        "PUBLIC_APP_URL",
        "PUBLIC_LANDING_URL"
      ]
    },
    "typecheck": {},
    "lint": {},
    "test": {
      "passThroughEnv": [
        "CARD_BUDGET_MS"
      ]
    },
    "@commitscape/landing#test": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "PUBLIC_APP_URL",
        "PUBLIC_LANDING_URL"
      ]
    }
  }
}
