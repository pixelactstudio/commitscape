{
  "name": "commitscape-workspace",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "turbo run typecheck lint test build",
    "e2e": "pnpm --filter @commitscape/site e2e",
    "services": "docker compose -f compose.dev.yaml up -d --wait",
    "dev:site": "pnpm --filter @commitscape/site dev",
    "dev:builder": "pnpm --filter @commitscape/builder dev",
    "db:generate": "pnpm --filter @commitscape/server db:generate",
    "db:custom": "pnpm --filter @commitscape/server db:custom"
  },
  "devDependencies": {
    "turbo": "2.11.6"
  }
}
